# Production .env — copy to the server as .env, fill the blanks, then `php artisan key:generate`.
APP_NAME="তোমার বাংলাদেশ কোথায়?"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
DB_TIMEZONE=+06:00
# Must be the real public https URL: share links and og:image are built from it.
APP_URL=https://example.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# cloudflare | * | comma-separated IPs. Without this, behind Cloudflare every visitor
# shares one rate limit. Leave empty only if visitors connect straight to this server.
TRUSTED_PROXIES=cloudflare

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amarbangladesh
DB_USERNAME=amarbangladesh
DB_PASSWORD=

# Sessions are only used by /admin.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Mail is needed for community password-reset emails (any SMTP provider).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="আমার বাংলাদেশ"

# Community sign-in: each method appears only when its keys are set (email always works).
# Redirect URIs: ${APP_URL}/auth/google/callback and ${APP_URL}/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Phone sign-in codes: empty hides phone sign-in; "bulksmsbd" sends real SMS.
SMS_DRIVER=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# Permanent super administrator (same identity as hospital-management). Created or repaired
# after every migrate, by db:seed, by `php artisan admin:ensure-super-admin`, and hourly on boot.
# The password is read only when creating the account (or with --reset-password); at least
# 10 characters with letters and digits. Keep it out of the repository: it is public.
SUPER_ADMIN_NAME=Raju
SUPER_ADMIN_EMAIL=rbraju3m@gmail.com
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_AUTO_PROVISION=true
SUPER_ADMIN_AUTO_PROVISION_INTERVAL=3600
