# Production .env — copy to the server as .env, fill the blanks, then `php artisan key:generate`.
APP_NAME="তোমার বাংলাদেশ কোথায়?"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must be the real public https URL: share links and og:image are built from it.
APP_URL=https://example.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# cloudflare | * | comma-separated IPs. Without this, behind Cloudflare every visitor
# shares one rate limit. Leave empty only if visitors connect straight to this server.
TRUSTED_PROXIES=cloudflare

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amarbangladesh
DB_USERNAME=amarbangladesh
DB_PASSWORD=

# Sessions are only used by /admin.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

# First deploy only (read by `php artisan db:seed`). Remove from .env afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
